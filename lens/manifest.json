{
  "manifest_version": 3,
  "name": "Vigil Lens",
  "short_name": "Vigil",
  "version": "0.1.0",
  "description": "See the rug before you click. Vigil puts a Clean, Watch or Bundled verdict next to every Solana token on pump.fun, Axiom, GMGN, DexScreener and X.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Vigil Lens", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://vigil-eight-ecru.vercel.app/*", "http://localhost:3100/*"],
  "content_scripts": [
    {
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://gmgn.ai/*",
        "https://dexscreener.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
