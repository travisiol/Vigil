{
  "manifest_version": 3,
  "name": "Vigil: Solana rug detector",
  "short_name": "Vigil",
  "version": "0.6.0",
  "description": "Click any Solana token on Axiom, GMGN, pump.fun, Padre or X: Vigil reads its launch and seals it Clean, Watch or Bundled.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Vigil",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://vigil-eight-ecru.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://dexscreener.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://trade.padre.gg/*",
        "https://photon-sol.tinyastro.io/*",
        "https://neo.bullx.io/*",
        "https://bullx.io/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "lens.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://vigil-eight-ecru.vercel.app",
  "minimum_chrome_version": "116"
}