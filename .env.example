# Copie ce fichier en ".env" puis remplis ta clé.
# Clé Helius gratuite : https://dashboard.helius.dev  (beaucoup plus rapide que le RPC public)
HELIUS_API_KEY=

# Ou n'importe quelle URL RPC Solana (prioritaire sur HELIUS_API_KEY si remplie)
RPC_URL=

# Requêtes par seconde (défaut : 3 en RPC public, 9 avec Helius)
RPC_RPS=

PORT=4477
